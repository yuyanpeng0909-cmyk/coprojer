[
  {
    "id": "0b296871-9fd2-40be-8495-3163890c6d80",
    "title": "原型 1",
    "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>番茄钟助手 · 原型（可爱手绘风）</title>\n<style>\n/* ============ 主题变量 ============ */\n:root{\n  --bg:#FFF8EC; --paper:#FFFDF6; --ink:#4A3F35; --ink-soft:#8B7D6B;\n  --accent:#FF6B57; --accent-soft:#FFD9D2; --green:#6FBF73; --green-soft:#DDF0DE;\n  --blue:#5BA8E8; --blue-soft:#DCEBFb; --yellow:#FFC94D; --line:#4A3F35;\n  --shadow:rgba(74,63,53,.15); --card:#FFFFFF;\n}\n[data-theme=\"dark\"]{\n  --bg:#2B2622; --paper:#332D27; --ink:#F2E8DA; --ink-soft:#B3A692;\n  --accent:#FF8A75; --accent-soft:#5A3630; --green:#8BD490; --green-soft:#33452F;\n  --blue:#7FBDEF; --blue-soft:#2E3D4A; --yellow:#FFD166; --line:#F2E8DA;\n  --shadow:rgba(0,0,0,.4); --card:#3B342C;\n}\n*{margin:0;padding:0;box-sizing:border-box;}\nbody{\n  font-family:\"Segoe Print\",\"Comic Sans MS\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",cursive,sans-serif;\n  background:var(--bg); color:var(--ink); min-height:100vh;\n  display:flex; align-items:center; justify-content:center; padding:20px;\n  transition:background .4s,color .4s;\n  background-image:radial-gradient(var(--shadow) 1px,transparent 1px);\n  background-size:22px 22px;\n}\n/* ============ 桌面窗口外壳 ============ */\n.window{\n  width:420px; background:var(--paper); border:2.5px solid var(--line);\n  border-radius:255px 18px 225px 18px/18px 225px 18px 255px;\n  box-shadow:6px 8px 0 var(--shadow); overflow:hidden; transition:background .4s,border-color .4s;\n}\n.titlebar{\n  display:flex; align-items:center; gap:8px; padding:10px 16px;\n  border-bottom:2px dashed var(--line); background:var(--card);\n}\n.dot{width:12px;height:12px;border-radius:50%;border:2px solid var(--line);}\n.dot.r{background:var(--accent);} .dot.y{background:var(--yellow);} .dot.g{background:var(--green);}\n.titlebar span{margin-left:6px;font-size:13px;color:var(--ink-soft);}\n.titlebar .ver{margin-left:auto;font-size:11px;color:var(--ink-soft);}\n/* ============ 标签页 ============ */\n.tabs{display:flex;gap:6px;padding:12px 16px 0;}\n.tab{\n  flex:1; text-align:center; padding:8px 0; cursor:pointer; font-size:15px;\n  border:2px solid var(--line); background:var(--card); color:var(--ink-soft);\n  border-radius:15px 20px 0 0/20px 15px 0 0; border-bottom:none; transform:translateY(2px);\n  transition:all .2s; user-select:none;\n}\n.tab:hover{transform:translateY(0) rotate(-1deg);}\n.tab.active{background:var(--accent-soft);color:var(--ink);font-weight:bold;transform:translateY(0);}\n/* ============ 页面容器 ============ */\n.page{display:none;padding:20px 22px 26px;border-top:2px dashed var(--line);}\n.page.active{display:block;animation:pop .3s ease;}\n@keyframes pop{from{opacity:0;transform:translateY(6px) rotate(.5deg);}to{opacity:1;}}\n/* ============ 计时页 ============ */\n.phase-tag{\n  display:inline-block; padding:4px 18px; font-size:15px; font-weight:bold;\n  border:2px solid var(--line); border-radius:20px 5px 20px 5px/5px 20px 5px 20px;\n  background:var(--accent-soft); transform:rotate(-2deg); margin-bottom:6px;\n}\n.phase-tag.break{background:var(--green-soft);}\n.phase-tag.long{background:var(--blue-soft);}\n.timer-wrap{position:relative;width:250px;height:250px;margin:8px auto 4px;}\nsvg.ring{width:100%;height:100%;transform:rotate(-90deg);}\n.ring .bgc{fill:none;stroke:var(--accent-soft);stroke-width:11;stroke-linecap:round;}\n.ring .fgc{fill:none;stroke:var(--accent);stroke-width:11;stroke-linecap:round;stroke-dasharray:660;transition:stroke-dashoffset .5s linear,stroke .3s;}\n.timer-wrap.break .bgc{stroke:var(--green-soft);} .timer-wrap.break .fgc{stroke:var(--green);}\n.timer-wrap.long .bgc{stroke:var(--blue-soft);} .timer-wrap.long .fgc{stroke:var(--blue);}\n.timer-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}\n.big-time{font-size:54px;font-weight:bold;letter-spacing:2px;font-variant-numeric:tabular-nums;line-height:1;}\n.big-time.paused{animation:blink 1.2s infinite;}\n@keyframes blink{50%{opacity:.35;}}\n.sub-status{font-size:13px;color:var(--ink-soft);margin-top:6px;}\n/* 番茄计数 */\n.tomato-row{display:flex;justify-content:center;gap:8px;margin:10px 0 4px;}\n.tomato{width:22px;height:22px;border:2px solid var(--line);border-radius:50% 50% 45% 55%/55% 45% 55% 45%;background:var(--card);position:relative;transition:all .3s;}\n.tomato.full{background:var(--accent);}\n.tomato.full::after{content:\"\";position:absolute;top:-5px;left:8px;width:6px;height:6px;background:var(--green);border-radius:0 50% 0 50%;border:1.5px solid var(--line);}\n.tomato.doing{animation:wiggle 1.5s infinite;border-color:var(--accent);}\n@keyframes wiggle{0%,100%{transform:rotate(-6deg);}50%{transform:rotate(6deg) scale(1.1);}}\n/* 按钮 */\n.btn-row{display:flex;gap:10px;justify-content:center;margin-top:14px;flex-wrap:wrap;}\nbutton{\n  font-family:inherit; cursor:pointer; font-size:15px; color:var(--ink);\n  border:2.5px solid var(--line); background:var(--card); padding:9px 20px;\n  border-radius:225px 15px 255px 15px/15px 255px 15px 225px;\n  box-shadow:3px 3px 0 var(--shadow); transition:all .15s;\n}\nbutton:hover{transform:rotate(-1.5deg) translateY(-2px);box-shadow:4px 5px 0 var(--shadow);}\nbutton:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--shadow);}\nbutton.primary{background:var(--accent);color:#fff;font-weight:bold;font-size:17px;padding:10px 30px;}\nbutton.ghost{background:transparent;color:var(--ink-soft);font-size:13px;padding:7px 14px;}\nbutton:disabled{opacity:.4;cursor:not-allowed;transform:none;}\n/* 提示气泡 */\n.toast{\n  position:absolute;left:50%;top:56px;transform:translateX(-50%) rotate(-1deg);\n  background:var(--yellow);border:2px solid var(--line);padding:8px 16px;font-size:13px;\n  border-radius:15px 20px 15px 20px/20px 15px 20px 15px;box-shadow:3px 3px 0 var(--shadow);\n  opacity:0;pointer-events:none;transition:opacity .3s;z-index:9;white-space:nowrap;color:#4A3F35;\n}\n.toast.show{opacity:1;}\n/* ============ 设置页 ============ */\n.set-group{margin-bottom:16px;}\n.set-group h3{font-size:14px;color:var(--ink-soft);margin-bottom:8px;transform:rotate(-1deg);}\n.set-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}\n.set-item{\n  background:var(--card);border:2px solid var(--line);padding:10px 12px;\n  border-radius:15px 20px 15px 20px/20px 15px 20px 15px;\n}\n.set-item label{font-size:13px;display:block;margin-bottom:4px;}\n.set-item input[type=number]{\n  width:70px;font-family:inherit;font-size:17px;font-weight:bold;color:var(--ink);\n  border:2px solid var(--line);border-radius:10px 14px 10px 14px;padding:3px 8px;background:var(--paper);\n}\n.set-item .unit{font-size:12px;color:var(--ink-soft);}\n.set-row{display:flex;align-items:center;justify-content:space-between;background:var(--card);\n  border:2px solid var(--line);padding:10px 14px;margin-bottom:8px;\n  border-radius:15px 20px 15px 20px/20px 15px 20px 15px;font-size:14px;}\n.err{color:var(--accent);font-size:12px;margin-top:3px;min-height:14px;display:block;}\n/* 开关 */\n.switch{width:46px;height:26px;border:2px solid var(--line);border-radius:20px;background:var(--paper);position:relative;cursor:pointer;flex-shrink:0;}\n.switch::after{content:\"\";position:absolute;top:2px;left:3px;width:17px;height:17px;border-radius:50%;background:var(--ink-soft);border:2px solid var(--line);transition:all .2s;}\n.switch.on{background:var(--green-soft);}\n.switch.on::after{left:22px;background:var(--green);}\n/* 滑杆 */\ninput[type=range]{-webkit-appearance:none;width:130px;height:8px;background:var(--accent-soft);border:2px solid var(--line);border-radius:10px;cursor:pointer;}\ninput[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--accent);border:2px solid var(--line);}\n/* ============ 统计页 ============ */\n.stat-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}\n.stat-card{border:2px solid var(--line);padding:12px;text-align:center;background:var(--card);\n  border-radius:20px 15px 25px 15px/15px 25px 15px 20px;transform:rotate(-1deg);}\n.stat-card:nth-child(2){transform:rotate(1deg);}\n.stat-card .num{font-size:30px;font-weight:bold;color:var(--accent);}\n.stat-card:nth-child(2) .num{color:var(--green);}\n.stat-card .lbl{font-size:12px;color:var(--ink-soft);}\n.chart-title{font-size:14px;color:var(--ink-soft);margin:8px 0 6px;transform:rotate(-1deg);}\n.bars{display:flex;align-items:flex-end;gap:8px;height:90px;padding:6px 4px;border:2px dashed var(--line);border-radius:15px;background:var(--card);}\n.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;height:100%;justify-content:flex-end;}\n.bar{width:70%;background:var(--accent);border:2px solid var(--line);border-radius:8px 12px 4px 4px;min-height:4px;transition:height .5s;}\n.bar.today{background:var(--yellow);}\n.bar-lbl{font-size:10px;color:var(--ink-soft);}\n.hist-list{max-height:120px;overflow-y:auto;border:2px solid var(--line);border-radius:15px;background:var(--card);padding:6px 10px;font-size:12px;}\n.hist-item{display:flex;justify-content:space-between;padding:5px 2px;border-bottom:1px dashed var(--ink-soft);}\n.hist-item:last-child{border-bottom:none;}\n.hist-item .cut{color:var(--accent);}\n.hist-empty{text-align:center;color:var(--ink-soft);padding:14px 0;}\n.danger-btn{background:var(--accent-soft);font-size:13px;padding:7px 16px;margin-top:10px;}\n::-webkit-scrollbar{width:8px;} ::-webkit-scrollbar-thumb{background:var(--ink-soft);border-radius:8px;}\n</style>\n</head>\n<body>\n<div class=\"window\">\n  <div class=\"titlebar\">\n    <div class=\"dot r\"></div><div class=\"dot y\"></div><div class=\"dot g\"></div>\n    <span>🍅 番茄钟助手</span><span class=\"ver\">v1.0 · 原型</span>\n  </div>\n  <div class=\"toast\" id=\"toast\"></div>\n  <div class=\"tabs\">\n    <div class=\"tab active\" data-tab=\"timer\">⏰ 计时</div>\n    <div class=\"tab\" data-tab=\"stats\">📊 统计</div>\n    <div class=\"tab\" data-tab=\"settings\">⚙️ 设置</div>\n  </div>\n\n  <!-- ===== 计时页 ===== -->\n  <div class=\"page active\" id=\"page-timer\">\n    <div style=\"text-align:center;\"><span class=\"phase-tag\" id=\"phaseTag\">🍅 准备专注</span></div>\n    <div class=\"timer-wrap\" id=\"timerWrap\">\n      <svg class=\"ring\" viewBox=\"0 0 240 240\">\n        <circle class=\"bgc\" cx=\"120\" cy=\"120\" r=\"105\"/>\n        <circle class=\"fgc\" id=\"ringFg\" cx=\"120\" cy=\"120\" r=\"105\"/>\n      </svg>\n      <div class=\"timer-center\">\n        <div class=\"big-time\" id=\"bigTime\">25:00</div>\n        <div class=\"sub-status\" id=\"subStatus\">点「开始」进入第一个番茄</div>\n      </div>\n    </div>\n    <div class=\"tomato-row\" id=\"tomatoRow\"></div>\n    <div style=\"text-align:center;font-size:12px;color:var(--ink-soft);\" id=\"cycleHint\">每 4 个番茄 → 15 分钟长休息</div>\n    <div class=\"btn-row\">\n      <button class=\"primary\" id=\"btnMain\">▶ 开始</button>\n      <button id=\"btnReset\">↺ 重置</button>\n      <button class=\"ghost\" id=\"btnEnd\" disabled>✋ 手动结束</button>\n    </div>\n  </div>\n\n  <!-- ===== 统计页 ===== -->\n  <div class=\"page\" id=\"page-stats\">\n    <div class=\"stat-cards\">\n      <div class=\"stat-card\"><div class=\"num\" id=\"stTomato\">0</div><div class=\"lbl\">今日完成番茄 🍅</div></div>\n      <div class=\"stat-card\"><div class=\"num\" id=\"stFocus\">0</div><div class=\"lbl\">今日专注（分钟）⏱</div></div>\n      <div class=\"stat-card\"><div class=\"num\" id=\"stWeek\">0</div><div class=\"lbl\">本周专注（分钟）📅</div></div>\n      <div class=\"stat-card\"><div class=\"num\" id=\"stMonth\">0</div><div class=\"lbl\">本月专注（分钟）🗓</div></div>\n    </div>\n    <div class=\"chart-title\">近 7 日专注时长（分钟）</div>\n    <div class=\"bars\" id=\"bars\"></div>\n    <div class=\"chart-title\" style=\"margin-top:12px;\">历史记录</div>\n    <div class=\"hist-list\" id=\"histList\"></div>\n    <div style=\"text-align:center;\">\n      <button class=\"danger-btn\" id=\"btnClear\">🗑 清空历史数据</button>\n    </div>\n  </div>\n\n  <!-- ===== 设置页 ===== -->\n  <div class=\"page\" id=\"page-settings\">\n    <div class=\"set-group\">\n      <h3>⏳ 时长配置（下一周期生效）</h3>\n      <div class=\"set-grid\">\n        <div class=\"set-item\"><label>专注时长</label><input type=\"number\" id=\"inWork\" min=\"1\" max=\"120\"> <span class=\"unit\">分钟 (1–120)</span><span class=\"err\" id=\"errWork\"></span></div>\n        <div class=\"set-item\"><label>短休息</label><input type=\"number\" id=\"inShort\" min=\"1\" max=\"60\"> <span class=\"unit\">分钟 (1–60)</span><span class=\"err\" id=\"errShort\"></span></div>\n        <div class=\"set-item\"><label>长休息</label><input type=\"number\" id=\"inLong\" min=\"1\" max=\"60\"> <span class=\"unit\">分钟 (1–60)</span><span class=\"err\" id=\"errLong\"></span></div>\n        <div class=\"set-item\"><label>长休息周期</label><input type=\"number\" id=\"inCycle\" min=\"2\" max=\"8\"> <span class=\"unit\">个番茄 (2–8)</span><span class=\"err\" id=\"errCycle\"></span></div>\n      </div>\n    </div>\n    <div class=\"set-group\">\n      <h3>🔔 提醒</h3>\n      <div class=\"set-row\"><span>提示音效</span><div class=\"switch on\" id=\"swSound\"></div></div>\n      <div class=\"set-row\"><span>提醒音量 <b id=\"volNum\">60</b></span><input type=\"range\" id=\"rgVol\" min=\"0\" max=\"100\" value=\"60\"></div>\n      <div class=\"set-row\"><span>免打扰模式（专注时屏蔽弹窗）</span><div class=\"switch\" id=\"swDnd\"></div></div>\n    </div>\n    <div class=\"set-group\">\n      <h3>🎨 外观与系统</h3>\n      <div class=\"set-row\"><span>深色主题</span><div class=\"switch\" id=\"swTheme\"></div></div>\n      <div class=\"set-row\"><span>开机自启（进入托盘）</span><div class=\"switch\" id=\"swBoot\"></div></div>\n    </div>\n    <div style=\"text-align:center;font-size:12px;color:var(--ink-soft);\">🔒 全部数据仅保存在本机，零联网 · 零广告</div>\n  </div>\n</div>\n\n<script>\n/* ================= 状态与持久化（仅当前预览环境） ================= */\nconst store = {\n  load(k,d){ try{ const v = localStorage.getItem('pomo_'+k); return v?JSON.parse(v):d; }catch(e){ return d; } },\n  save(k,v){ try{ localStorage.setItem('pomo_'+k,JSON.stringify(v)); }catch(e){} }\n};\nlet settings = store.load('settings',{ work:25, short:5, long:15, cycle:4, sound:true, volume:60, dnd:false, theme:'light', boot:false });\nlet history  = store.load('history',[]); // {date,type,start,minutes,completed,source}\n\n/* ================= 计时状态机（绝对时间戳，避免后台失准） ================= */\nconst S = {\n  phase:'idle',        // idle | focus | short | long\n  running:false, paused:false,\n  endAt:0, remainMs:0, totalMs:0,\n  cycleCount:0,        // 本轮已完成番茄数（长休后归 0）\n  startedAt:0\n};\nconst PHASE_NAME = { idle:'🍅 准备专注', focus:'🍅 专注中', short:'🌿 短休息', long:'😴 长休息' };\nconst CIRC = 2*Math.PI*105;\n\nfunction phaseMinutes(p){\n  if(p==='focus') return settings.work;\n  if(p==='short') return settings.short;\n  return settings.long;\n}\nfunction setPhase(p){\n  S.phase=p; S.running=false; S.paused=false;\n  S.totalMs = phaseMinutes(p)*60000;\n  S.remainMs = S.totalMs;\n  render();\n}\nfunction startPhase(p){\n  setPhase(p);\n  S.running=true; S.paused=false;\n  S.startedAt = Date.now();\n  S.endAt = Date.now() + S.totalMs;\n  notify(PHASE_NAME[p], p==='focus'?'深呼吸，开始专注吧！':'好好放松一下～');\n  render();\n}\nfunction tick(){\n  if(S.running && !S.paused){\n    S.remainMs = S.endAt - Date.now();\n    if(S.remainMs<=0){ completePhase(); return; }\n  }\n  render();\n}\nsetInterval(tick,200);\n\nfunction completePhase(){\n  S.running=false;\n  const p=S.phase;\n  if(p==='focus'){\n    S.cycleCount++;\n    addRecord('focus', settings.work, true, 'auto');\n    notify('🎉 番茄完成！','第 '+S.cycleCount+' 个番茄完成，休息一下吧');\n    startPhase(S.cycleCount % settings.cycle===0 ? 'long' : 'short');\n  }else{\n    if(p==='long'){ S.cycleCount=0; addRecord('long', settings.long, true, 'auto'); }\n    else addRecord('short', settings.short, true, 'auto');\n    startPhase('focus');\n  }\n}\nfunction manualEnd(){\n  if(S.phase==='idle'||!S.startedAt) return;\n  if(S.phase==='focus'){\n    const elapsed = Math.min(Math.floor((Date.now()-S.startedAt)/60000), phaseMinutes('focus'));\n    // 人工定案口径：计入时长，不计完成数；不足 1 分钟也留 1 条记录（原型简化按 0 也记）\n    addRecord('focus', elapsed, false, 'manual');\n    toast('已记录中断：专注 '+elapsed+' 分钟计入今日时长');\n  }else{\n    addRecord(S.phase, Math.floor((Date.now()-S.startedAt)/60000), false, 'manual');\n    toast('本次休息已提前结束');\n  }\n  setPhase('idle'); S.startedAt=0; renderStats();\n}\nfunction addRecord(type, minutes, completed, source){\n  const now=new Date();\n  history.unshift({ date: now.toISOString().slice(0,10), type, start: now.toTimeString().slice(0,5), minutes, completed, source });\n  store.save('history', history);\n  renderStats();\n}\n\n/* ================= 渲染 ================= */\nconst $=id=>document.getElementById(id);\nfunction fmt(ms){\n  const s=Math.max(0,Math.ceil(ms/1000));\n  return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');\n}\nfunction render(){\n  $('bigTime').textContent = fmt(S.remainMs);\n  $('bigTime').classList.toggle('paused', S.paused);\n  const tag=$('phaseTag');\n  tag.textContent = PHASE_NAME[S.phase] + (S.paused?'（已暂停）':'');\n  tag.className = 'phase-tag' + (S.phase==='short'?' break':S.phase==='long'?' long':'');\n  $('timerWrap').className = 'timer-wrap' + (S.phase==='short'?' break':S.phase==='long'?' long':'');\n  const ratio = S.totalMs? S.remainMs/S.totalMs : 0;\n  $('ringFg').style.strokeDashoffset = CIRC*(1-(S.phase==='idle'?1:ratio));\n  $('ringFg').setAttribute('stroke-dasharray', CIRC);\n  // 主按钮\n  const bm=$('btnMain');\n  if(S.phase==='idle'){ bm.textContent='▶ 开始'; }\n  else if(S.paused){ bm.textContent='▶ 继续'; }\n  else if(S.running){ bm.textContent='⏸ 暂停'; }\n  else { bm.textContent='▶ 开始'; }\n  $('btnEnd').disabled = (S.phase==='idle');\n  $('subStatus').textContent =\n    S.phase==='idle' ? '点「开始」进入第一个番茄' :\n    S.phase==='focus' ? '保持专注，手机放远一点～' :\n    S.phase==='short' ? '喝口水，看看窗外 🌱' : '起来走走，伸展一下身体 🧘';\n  // 番茄计数\n  const tr=$('tomatoRow'); tr.innerHTML='';\n  for(let i=0;i<settings.cycle;i++){\n    const t=document.createElement('div');\n    t.className='tomato'+(i<S.cycleCount?' full':(S.phase==='focus'&&i===S.cycleCount?' doing':''));\n    tr.appendChild(t);\n  }\n  $('cycleHint').textContent = '每 '+settings.cycle+' 个番茄 → '+settings.long+' 分钟长休息';\n}\n\n/* ================= 提醒（音效 + 模拟系统通知；免打扰只屏蔽应用内弹窗） ================= */\nlet audioCtx=null;\nfunction beep(){\n  if(!settings.sound) return;\n  try{\n    audioCtx = audioCtx || new (window.AudioContext||window.webkitAudioContext)();\n    const g=audioCtx.createGain(); g.gain.value=settings.volume/100*0.3; g.connect(audioCtx.destination);\n    [880,660,880].forEach((f,i)=>{\n      const o=audioCtx.createOscillator(); o.type='sine'; o.frequency.value=f;\n      o.connect(g); o.start(audioCtx.currentTime+i*0.18); o.stop(audioCtx.currentTime+i*0.18+0.15);\n    });\n  }catch(e){}\n}\nfunction notify(title,msg){ beep(); toast(title+'　'+msg); }\nlet toastTimer=null;\nfunction toast(msg){\n  const t=$('toast');\n  if(settings.dnd && S.phase==='focus'){ t.classList.remove('show'); return; } // 免打扰：专注时屏蔽应用内弹窗\n  t.textContent=msg; t.classList.add('show');\n  clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),2600);\n}\n\n/* ================= 统计 ================= */\nfunction renderStats(){\n  const today=new Date().toISOString().slice(0,10);\n  const now=new Date();\n  const weekStart=new Date(now); weekStart.setDate(now.getDate()-((now.getDay()+6)%7));\n  const ws=weekStart.toISOString().slice(0,10), ms=today.slice(0,7);\n  let tTom=0,tMin=0,wMin=0,mMin=0;\n  history.forEach(r=>{\n    if(r.date===today){ if(r.type==='focus'){ tMin+=r.minutes; if(r.completed) tTom++; } }\n    if(r.type==='focus'){ if(r.date>=ws) wMin+=r.minutes; if(r.date.slice(0,7)===ms) mMin+=r.minutes; }\n  });\n  $('stTomato').textContent=tTom; $('stFocus').textContent=tMin;\n  $('stWeek').textContent=wMin; $('stMonth').textContent=mMin;\n  // 近 7 天柱状图\n  const bars=$('bars'); bars.innerHTML='';\n  const days=[]; let max=1;\n  for(let i=6;i>=0;i--){\n    const d=new Date(now); d.setDate(now.getDate()-i);\n    const key=d.toISOString().slice(0,10);\n    const v=history.filter(r=>r.date===key&&r.type==='focus').reduce((a,r)=>a+r.minutes,0);\n    days.push({key,v}); if(v>max)max=v;\n  }\n  const wl=['日','一','二','三','四','五','六'];\n  days.forEach(d=>{\n    const col=document.createElement('div'); col.className='bar-col';\n    const dt=new Date(d.key);\n    col.innerHTML='<div class=\"bar'+(d.key===today?' today':'')+'\" style=\"height:'+Math.max(4,d.v/max*62)+'px\" title=\"'+d.v+' 分钟\"></div><div class=\"bar-lbl\">'+wl[dt.getDay()]+'</div>';\n    bars.appendChild(col);\n  });\n  // 历史\n  const hl=$('histList'); hl.innerHTML='';\n  if(!history.length){ hl.innerHTML='<div class=\"hist-empty\">还没有记录，完成一个番茄试试～</div>'; return; }\n  history.slice(0,30).forEach(r=>{\n    const div=document.createElement('div'); div.className='hist-item';\n    const nm = r.type==='focus'?'🍅 专注':(r.type==='short'?'🌿 短休':'😴 长休');\n    div.innerHTML='<span>'+r.date+' '+r.start+' '+nm+'</span>'+\n      (r.completed?'<span>'+r.minutes+' 分钟</span>':'<span class=\"cut\">中断 · '+r.minutes+' 分钟</span>');\n    hl.appendChild(div);\n  });\n}\n\n/* ================= 事件绑定 ================= */\n$('btnMain').onclick=()=>{\n  if(S.phase==='idle'){ startPhase('focus'); }\n  else if(S.paused){ S.paused=false; S.endAt=Date.now()+S.remainMs; notify('▶ 继续','计时恢复'); }\n  else if(S.running){ S.paused=true; }\n  render();\n};\n$('btnReset').onclick=()=>{\n  // 口径：仅回当前周期起点，不清番茄计数\n  if(S.phase==='idle'){ setPhase('idle'); }\n  else{ const p=S.phase; setPhase(p); toast('已重置当前周期（番茄计数保留）'); }\n  render();\n};\n$('btnEnd').onclick=manualEnd;\n\n// 标签页\ndocument.querySelectorAll('.tab').forEach(t=>{\n  t.onclick=()=>{\n    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));\n    document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));\n    t.classList.add('active');\n    $('page-'+t.dataset.tab).classList.add('active');\n    if(t.dataset.tab==='stats') renderStats();\n  };\n});\n\n// 设置输入 + 范围校验\nfunction bindNum(id,errId,key,min,max){\n  const el=$(id); el.value=settings[key];\n  el.onchange=()=>{\n    const v=parseInt(el.value,10); const err=$(errId);\n    if(isNaN(v)||v<min||v>max){\n      err.textContent='✏️ 请输入 '+min+'–'+max+' 之间的整数哦';\n      el.value=settings[key];\n      return;\n    }\n    err.textContent=''; settings[key]=v; store.save('settings',settings);\n    if(S.phase==='idle') setPhase('idle'); // 空闲时即时反映新时长\n    render(); toast('设置已保存，下一周期生效');\n  };\n}\nbindNum('inWork','errWork','work',1,120);\nbindNum('inShort','errShort','short',1,60);\nbindNum('inLong','errLong','long',1,60);\nbindNum('inCycle','errCycle','cycle',2,8);\n\nfunction bindSwitch(id,key,cb){\n  const el=$(id); el.classList.toggle('on',!!settings[key]);\n  el.onclick=()=>{ settings[key]=!settings[key]; el.classList.toggle('on',settings[key]); store.save('settings',settings); if(cb)cb(); };\n}\nbindSwitch('swSound','sound');\nbindSwitch('swDnd','dnd');\nbindSwitch('swBoot','boot');\nbindSwitch('swTheme','theme',applyTheme);\n$('rgVol').value=settings.volume; $('volNum').textContent=settings.volume;\n$('rgVol').oninput=e=>{ settings.volume=+e.target.value; $('volNum').textContent=settings.volume; store.save('settings',settings); };\n$('rgVol').onchange=()=>beep();\n\n// 清空历史（二次确认）\nlet clearArm=false;\n$('btnClear').onclick=()=>{\n  if(!clearArm){ clearArm=true; $('btnClear').textContent='⚠️ 再点一次确认清空（不可恢复）'; setTimeout(()=>{clearArm=false;$('btnClear').textContent='🗑 清空历史数据';},3000); return; }\n  history=[]; store.save('history',history); clearArm=false;\n  $('btnClear').textContent='🗑 清空历史数据';\n  renderStats(); toast('历史数据已清空，进行中的计时不受影响');\n};\n\n/* ================= 主题 ================= */\nfunction applyTheme(){ document.documentElement.setAttribute('data-theme', settings.theme==='dark'?'dark':'light'); }\napplyTheme();\nsetPhase('idle');\nrenderStats();\n</script>\n</body>\n</html>",
